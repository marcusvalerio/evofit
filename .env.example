# EVOFIT — variáveis de ambiente. Copie para .env.local (nunca commite valores reais).

# Projeto Supabase (Settings → API). Só a chave PUBLISHABLE/anon é usada: ela é pública por
# design, porque a RLS protege os dados. NUNCA coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública do site. Entra nos links de confirmação de e-mail e recuperação de senha.
# Em desenvolvimento: http://localhost:3000. Em produção: a URL final (https://...).
# Precisa estar na lista de "Redirect URLs" do Supabase (Authentication → URL Configuration).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
