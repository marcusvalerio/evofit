# Copie para .env.local e preencha. Nunca faça commit de .env.local.
#
# String de conexão do Neon (Dashboard → Connect). Use a URL "pooled" (host com -pooler) para o app.
# Sem esta variável o app funciona só no modo demonstração.
DATABASE_URL=

# Opcional: URL direta (sem -pooler) para rodar as migrações. Se vazia, usa DATABASE_URL.
DATABASE_URL_MIGRATIONS=

# Opcional: tamanho do pool de conexões por instância (padrão 5).
DB_POOL_MAX=
