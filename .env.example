# Copie para .env.local e preencha. Nunca faça commit de .env.local.
#
# String de conexão do Neon (Dashboard → Connect). Use a URL "pooled" (host com -pooler) para o app.
# Sem esta variável o app funciona só no modo demonstração.
DATABASE_URL=

# Opcional: URL direta (sem -pooler) para rodar as migrações. Se vazia, usa DATABASE_URL.
DATABASE_URL_MIGRATIONS=

# Opcional: tamanho do pool de conexões por instância (padrão 5).
DB_POOL_MAX=

# Stripe (pagamentos). Sem estas variáveis a tela de planos aparece, mas o botão de assinar avisa
# que os pagamentos não estão configurados. Use as chaves de teste (sk_test_...) até validar tudo.
STRIPE_SECRET_KEY=
# Painel do Stripe → Developers → Webhooks → endpoint https://SEU-DOMINIO/api/billing/webhook
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#          customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Opcional: id da configuração do portal do cliente (bpc_...) só do EVOFIT. Sem ela, usa a padrão da conta.
STRIPE_PORTAL_CONFIG=
# WhatsApp da equipe para o Vitalício pago por Pix (só dígitos, com 55 e DDD). Ex.: 5521999999999
SALES_WHATSAPP=

# Robô de WhatsApp (Evolution API, código aberto, rodando num servidor seu). Ver docs/WHATSAPP.md.
# Sem estas variáveis nada é enviado. Conexão por QR Code não é oficial: o número pode ser bloqueado.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Quem recebe os avisos da equipe (novo cadastro, pedido de Vitalício, assinatura). Vazio = SALES_WHATSAPP.
ADMIN_WHATSAPP=
# Segredo do Vercel Cron (lembretes diários do teste grátis).
CRON_SECRET=
# Vendedor automático: segredo da URL do webhook da Evolution API (?token=...). Ver docs/WHATSAPP.md.
EVOLUTION_WEBHOOK_TOKEN=
# Endereço público do app, usado nos links das mensagens.
SITE_URL=https://evofit-pi.vercel.app

# E-mail (Resend): recuperação de senha. Precisa de um domínio verificado no Resend.
RESEND_API_KEY=
# Remetente, ex.: EVOFIT <nao-responda@evofit.com.br>
EMAIL_FROM=

# Monitoramento: cadastre https://SEU-DOMINIO/api/health num monitor grátis (ex.: UptimeRobot).
# 200 = no ar; 503 = banco fora. Erros do sistema aparecem no admin.
